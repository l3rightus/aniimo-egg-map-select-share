{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid && newData.child('host').val() === auth.uid))",
        ".validate": "$roomId.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['host', 'mapId', 'createdAt', 'updatedAt'])",
        "host": { ".validate": "newData.isString()" },
        "mapId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "marks": {
          "$mapId": {
            ".validate": "$mapId.length <= 64",
            "$markId": {
              ".validate": "newData.hasChildren(['x', 'y'])",
              "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      "$roomId": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean() && root.child('rooms').child($roomId).exists()"
        }
      }
    }
  }
}
